---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Florent Coulon",
  "jobTitle": "Fondateur & Directeur Technique",
  "url": "https://bubblestone.ai/a-propos",
  "image": "https://bubblestone.ai/images/team/florent.jpg",
  "sameAs": [
    "https://www.linkedin.com/in/florentcoulon"
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "BubbleStone AI",
    "url": "https://bubblestone.ai"
  },
  "knowsAbout": [
    "Intelligence Artificielle", "Machine Learning", "LLM",
    "Infrastructure Cloud", "DevOps", "Automatisation",
    "Docker", "Terraform", "n8n", "RAG", "Agents IA"
  ],
  "description": "Expert IT avec plus de 20 ans d'expérience en infrastructure, cloud, développement, data et automatisation. Fondateur de BubbleStone AI, agence spécialisée dans l'intégration IA en entreprise."
});
---

<Layout 
  title="À propos — Florent Coulon & BubbleStone AI" 
  description="Découvrez BubbleStone AI et son fondateur Florent Coulon. 20+ ans d'expérience IT au service de l'intégration IA en entreprise."
>
  <Header />
  
  <main class="about-page">
    <section class="about-hero">
      <div class="container">
        <span class="section-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          À propos
        </span>
        <h1>20 ans d'IT.<br><span class="text-gradient">L'IA en plus.</span></h1>
      </div>
    </section>

    <section class="about-content">
      <div class="container">
        <div class="founder-section">
          <div class="founder-image">
            <img src="/images/team/florent.jpg" alt="Florent Coulon — Fondateur BubbleStone AI" />
          </div>
          <div class="founder-text">
            <h2>Florent Coulon</h2>
            <p class="founder-title">Fondateur & Directeur Technique</p>
            <p>Plus de 20 ans dans l'IT, des datacenters aux architectures cloud, du code au management. J'ai vu passer des dizaines de "révolutions" technologiques. L'IA est la seule qui change vraiment les règles du jeu.</p>
            <p>J'ai créé BubbleStone AI avec une conviction simple : <strong>l'IA ne doit pas rester un sujet de conférence</strong>. Elle doit être dans vos processus, vos outils, vos équipes. Concrètement. Maintenant.</p>
            <p>Mon approche : comprendre votre métier d'abord, proposer la technologie ensuite. Pas l'inverse. Chaque solution doit être simple, robuste et maintenable. Si c'est compliqué, c'est qu'on s'y prend mal.</p>
            
            <div class="founder-links">
              <a href="https://www.linkedin.com/in/florentcoulon" target="_blank" rel="noopener" class="social-link">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
            </div>
          </div>
        </div>

        <div class="values-section">
          <h2>Ce qu'on fait — et comment on le fait</h2>
          <div class="values-grid">
            <div class="value-item">
              <h3>Clarté</h3>
              <p>Pas de jargon. On traduit la complexité pour que tout soit clair. Vous comprenez ce qu'on fait et pourquoi on le fait.</p>
            </div>
            <div class="value-item">
              <h3>Autonomie</h3>
              <p>L'objectif : que vous n'ayez plus besoin de nous. On forme vos équipes et on documente tout. Pas de dépendance.</p>
            </div>
            <div class="value-item">
              <h3>Simplicité</h3>
              <p>La solution la plus simple qui fonctionne. Toujours. On ne sur-ingénierie pas, on ne complique pas pour justifier des jours de prestation.</p>
            </div>
            <div class="value-item">
              <h3>Durabilité</h3>
              <p>Des solutions qui tiennent, documentées, maintenables. Pas de proof-of-concept abandonné. Du code en production qui dure.</p>
            </div>
          </div>
        </div>

        <div class="expertise-section">
          <h2>Expertise technique</h2>
          <div class="expertise-grid">
            <div class="expertise-cat">
              <h3>IA & Machine Learning</h3>
              <div class="expertise-tags">
                <span>LLM</span><span>Claude</span><span>Mistral</span><span>RAG</span>
                <span>Fine-tuning</span><span>Agents IA</span><span>MCP</span><span>Embeddings</span>
              </div>
            </div>
            <div class="expertise-cat">
              <h3>Infrastructure & DevOps</h3>
              <div class="expertise-tags">
                <span>Docker</span><span>Terraform</span><span>CI/CD</span><span>Linux</span>
                <span>Nginx</span><span>PostgreSQL</span><span>Monitoring</span><span>GitHub Actions</span>
              </div>
            </div>
            <div class="expertise-cat">
              <h3>Automatisation</h3>
              <div class="expertise-tags">
                <span>n8n</span><span>API</span><span>Webhooks</span><span>Workflows</span>
                <span>CRM</span><span>ETL</span><span>Scraping</span><span>No-code</span>
              </div>
            </div>
          </div>
        </div>

        <div class="cta-section">
          <h2>Un projet en tête ?</h2>
          <p>Diagnostic gratuit, sans engagement. On regarde ensemble ce que l'IA peut faire pour votre business.</p>
          <a href="/#contact" class="btn btn-primary btn-lg">
            Discutons
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={personSchema} />
  <Footer />
</Layout>

<style>
  .about-page { padding-top: 80px; }
  .container { max-width: 900px; margin: 0 auto; padding: 0 1.5rem; }

  .about-hero {
    padding: 4rem 0 2rem;
    text-align: center;
    background: var(--gradient-hero);
  }
  .about-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-primary);
    margin: 1rem 0 0;
    line-height: 1.2;
  }
  .text-gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .section-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: var(--radius-full);
    font-size: 0.875rem; font-weight: 500; color: var(--color-accent);
  }

  .about-content { padding: 3rem 0 4rem; }

  .founder-section {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-bottom: 4rem;
  }
  .founder-image img {
    width: 200px;
    height: 200px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--crystal-shadow);
  }
  .founder-text h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }
  .founder-title {
    color: var(--color-accent);
    font-weight: 500;
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }
  .founder-text p {
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .founder-links { margin-top: 1.5rem; }
  .social-link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--color-accent); text-decoration: none;
    font-weight: 500; font-size: 0.9rem;
  }
  .social-link:hover { opacity: 0.8; }

  .values-section, .expertise-section {
    margin-bottom: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-100);
  }
  .values-section h2, .expertise-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem; font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 1.5rem;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .value-item {
    padding: 1.5rem;
    background: var(--color-gray-50);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-gray-100);
  }
  .value-item h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem; font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.5rem;
  }
  .value-item p {
    color: var(--color-gray-500);
    font-size: 0.9rem; line-height: 1.6; margin: 0;
  }

  .expertise-grid { display: grid; gap: 1.5rem; }
  .expertise-cat h3 {
    font-size: 1rem; font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .expertise-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .expertise-tags span {
    padding: 0.3rem 0.75rem;
    background: rgba(59, 130, 246, 0.08);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-size: 0.8rem; font-weight: 500;
  }

  .cta-section {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--stone-dark);
    border-radius: var(--radius-xl);
    color: white;
    margin-top: 2rem;
  }
  .cta-section h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem; margin: 0 0 0.75rem;
  }
  .cta-section p {
    color: var(--color-gray-400);
    margin: 0 0 1.5rem; line-height: 1.6;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.75rem 1.5rem; border-radius: var(--radius-md);
    font-weight: 600; text-decoration: none; font-size: 0.95rem;
    transition: all 0.2s;
  }
  .btn-primary { background: var(--color-accent); color: white; }
  .btn-primary:hover { background: var(--color-accent-dark); }

  @media (max-width: 768px) {
    .founder-section {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .founder-image { display: flex; justify-content: center; }
    .founder-image img { width: 150px; height: 150px; }
    .values-grid { grid-template-columns: 1fr; }
    .founder-links { display: flex; justify-content: center; }
  }
</style>
