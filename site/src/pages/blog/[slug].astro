---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.date.toISOString(),
  "dateModified": (post.data.updated || post.data.date).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://www.linkedin.com/in/florentcoulon",
    "jobTitle": "Fondateur & Directeur Technique",
    "worksFor": { "@type": "Organization", "name": "BubbleStone AI" }
  },
  "publisher": {
    "@type": "Organization",
    "name": "BubbleStone AI",
    "url": "https://bubblestone.ai",
    "logo": { "@type": "ImageObject", "url": "https://bubblestone.ai/logo.png" }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://bubblestone.ai/blog/${post.slug}/`
  },
  "keywords": post.data.tags.join(", "),
  "inLanguage": "fr-FR"
});
---

<Layout 
  title={post.data.title}
  description={post.data.description}
  type="article"
  dateModified={(post.data.updated || post.data.date).toISOString().split('T')[0]}
>
  <Header />
  
  <main class="article-page">
    <article class="article">
      <div class="container">
        <div class="article-header">
          <a href="/blog/" class="back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            Retour au blog
          </a>
          
          <div class="article-meta">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span class="meta-sep">·</span>
            <span>{post.data.author}</span>
          </div>
          
          <h1>{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>
          
          {post.data.tags.length > 0 && (
            <div class="article-tags">
              {post.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>

        <div class="article-content">
          <Content />
        </div>

        <div class="article-footer">
          <div class="author-card">
            <img src="/images/team/florent.jpg" alt="Florent Coulon" class="author-avatar" />
            <div class="author-info">
              <strong>Florent Coulon</strong>
              <p>Fondateur de BubbleStone AI. 20+ ans d'expérience IT. Passionné par l'IA appliquée et l'automatisation des processus métier.</p>
              <a href="https://www.linkedin.com/in/florentcoulon" target="_blank" rel="noopener">
                Voir le profil LinkedIn →
              </a>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <script type="application/ld+json" set:html={articleSchema} />
  <Footer />
</Layout>

<style>
  .article-page {
    padding-top: 80px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .article-header {
    padding: 3rem 0 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gray-400);
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .meta-sep {
    color: var(--color-gray-300);
  }

  .article-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .article-desc {
    font-size: 1.125rem;
    color: var(--color-gray-500);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(59, 130, 246, 0.08);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .article-content {
    padding: 2rem 0;
    border-top: 1px solid var(--color-gray-100);
  }

  .article-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 2.5rem 0 1rem;
  }

  .article-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 2rem 0 0.75rem;
  }

  .article-content :global(p) {
    color: var(--color-gray-600);
    line-height: 1.8;
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
  }

  .article-content :global(strong) {
    color: var(--color-primary);
    font-weight: 600;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    color: var(--color-gray-600);
    line-height: 1.8;
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: rgba(59, 130, 246, 0.04);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .article-content :global(blockquote p) {
    color: var(--color-gray-600);
    font-style: italic;
    margin: 0;
  }

  .article-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-gray-100);
    margin: 2rem 0;
  }

  .article-footer {
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--color-gray-100);
  }

  .author-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--color-gray-50);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-100);
  }

  .author-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-info strong {
    display: block;
    font-family: var(--font-heading);
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .author-info p {
    font-size: 0.875rem;
    color: var(--color-gray-500);
    line-height: 1.5;
    margin: 0 0 0.5rem;
  }

  .author-info a {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .author-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
