---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Blog — Veille IA & Automatisation" 
  description="Articles, analyses et études de cas sur l'intégration de l'IA en entreprise."
  type="website"
>
  <link rel="stylesheet" href="/blog.css" slot="head" />
  <Header />
  
  <div id="bp">
    <p id="bp-badge">📖 Blog</p>
    <div id="bp-h1">L'IA appliquée, sans bullshit.</div>
    <p id="bp-sub">Analyses, retours d'expérience et veille tech sur l'IA en entreprise.</p>

    {posts.length === 0 ? (
      <p id="bp-empty">Les premiers articles arrivent bientôt.</p>
    ) : (
      posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="bp-card">
          <div class="bp-meta">
            <span class="bp-date">
              {post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
            </span>
            {post.data.tags.slice(0, 2).map((tag: string) => (
              <span class="bp-tag">{tag}</span>
            ))}
          </div>
          <div class="bp-title">{post.data.title}</div>
          <p class="bp-excerpt">{post.data.description}</p>
          <span class="bp-cta">Lire l'article →</span>
        </a>
      ))
    )}
  </div>

  <Footer />
</Layout>
