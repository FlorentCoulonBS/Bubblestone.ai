---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Blog — Veille IA & Automatisation" 
  description="Articles, analyses et études de cas sur l'intégration de l'IA en entreprise. Automatisation, agents IA, infrastructure cloud, data management."
  type="website"
>
  <Header />
  
  <main class="blog-page">
    <div class="blog-container">
      <div class="blog-intro">
        <span class="badge">📖 Blog</span>
        <h1>L'IA appliquée, <span class="text-gradient">sans bullshit.</span></h1>
        <p>Analyses, retours d'expérience et veille tech sur l'IA en entreprise.</p>
      </div>

      {posts.length === 0 ? (
        <p class="no-posts">Les premiers articles arrivent bientôt.</p>
      ) : (
        <div class="posts-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="post-card">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
                {post.data.tags.slice(0, 2).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2>{post.data.title}</h2>
              <p class="excerpt">{post.data.description}</p>
              <span class="read-cta">Lire l'article →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .blog-page {
    padding-top: 100px;
    padding-bottom: 4rem;
    min-height: 100vh;
    background: white;
  }

  .blog-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-intro {
    margin-bottom: 2rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .blog-intro h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
    line-height: 1.3;
  }

  .text-gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-intro p {
    color: var(--color-gray-500);
    font-size: 0.95rem;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    gap: 1rem;
  }

  .post-card {
    display: block;
    padding: 1.25rem 1.5rem;
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-left: 3px solid var(--color-accent);
    border-radius: 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.1);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    font-size: 0.78rem;
    color: var(--color-gray-400);
    font-weight: 500;
  }

  .tag {
    font-size: 0.68rem;
    padding: 0.1rem 0.5rem;
    background: rgba(59, 130, 246, 0.07);
    color: var(--color-accent);
    border-radius: 99px;
    font-weight: 500;
  }

  .post-card h2 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.3rem;
    line-height: 1.35;
  }

  .excerpt {
    color: var(--color-gray-500);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-cta {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 600;
  }

  .no-posts {
    text-align: center;
    color: var(--color-gray-400);
    padding: 3rem 0;
  }

  @media (max-width: 768px) {
    .blog-intro h1 { font-size: 1.4rem; }
    .post-card { padding: 1rem 1.25rem; }
  }
</style>
