---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Blog — Veille IA & Automatisation" 
  description="Articles, analyses et études de cas sur l'intégration de l'IA en entreprise. Automatisation, agents IA, infrastructure cloud, data management."
  type="website"
>
  <Header />
  
  <main class="blog-page">
    <section class="blog-hero">
      <div class="container">
        <div class="hero-inner">
          <span class="section-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            Blog
          </span>
          <h1>L'IA appliquée, <span class="text-gradient">sans bullshit.</span></h1>
          <p class="blog-hero-sub">Analyses, retours d'expérience et veille tech sur l'IA en entreprise.</p>
        </div>
      </div>
    </section>

    <section class="blog-list">
      <div class="container">
        {posts.length === 0 ? (
          <p class="no-posts">Les premiers articles arrivent bientôt.</p>
        ) : (
          <div class="posts-grid">
            {posts.map((post, i) => (
              <a href={`/blog/${post.slug}/`} class={`post-card ${i === 0 ? 'post-featured' : ''}`}>
                <div class="post-card-inner">
                  <div class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </time>
                    {post.data.tags.slice(0, 2).map((tag: string) => (
                      <span class="post-tag">{tag}</span>
                    ))}
                  </div>
                  <h2>{post.data.title}</h2>
                  <p class="post-excerpt">{post.data.description}</p>
                  <div class="post-footer">
                    <div class="post-author">
                      <img src="/images/team/florent.jpg" alt="" class="author-tiny" />
                      <span>{post.data.author}</span>
                    </div>
                    <span class="read-more">
                      Lire
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .blog-page {
    padding-top: 80px;
    min-height: 100vh;
    background: white;
  }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero compact */
  .blog-hero {
    padding: 2rem 0 0;
  }

  .hero-inner {
    max-width: 600px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    background: rgba(59, 130, 246, 0.06);
    border: 1px solid rgba(59, 130, 246, 0.12);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .blog-hero h1 {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0.5rem 0 0.25rem;
    line-height: 1.25;
  }

  .text-gradient {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .blog-hero-sub {
    color: var(--color-gray-500);
    font-size: 0.95rem;
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  /* Posts */
  .blog-list {
    padding: 0 0 4rem;
  }

  .posts-grid {
    display: grid;
    gap: 1rem;
  }

  .post-card {
    display: block;
    background: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.1);
    transform: translateY(-1px);
  }

  .post-featured {
    border-left: 3px solid var(--color-accent);
  }

  .post-card-inner {
    padding: 1.5rem 1.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .post-meta time {
    font-size: 0.8rem;
    color: var(--color-gray-400);
    font-weight: 500;
  }

  .post-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.55rem;
    background: rgba(59, 130, 246, 0.07);
    color: var(--color-accent);
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .post-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 0.4rem;
    line-height: 1.35;
  }

  .post-excerpt {
    color: var(--color-gray-500);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-gray-100);
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-tiny {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .post-author span {
    font-size: 0.8rem;
    color: var(--color-gray-400);
    font-weight: 500;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .no-posts {
    text-align: center;
    color: var(--color-gray-400);
    padding: 4rem 0;
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .blog-hero h1 { font-size: 1.5rem; }
    .post-card-inner { padding: 1.25rem; }
    .post-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
